---
export interface Props {
 title:string;description?:string;lang?:'zh'|'en';structuredData?:Record<string,unknown>;image?:string;
}
const {title,description='鹈鹕游戏是一家独立游戏创作工作室。从真实世界中寻找灵感，用游戏创造值得经历的体验。',lang='zh',structuredData,image}=Astro.props;
const en=lang==='en';
const route=Astro.url.pathname.replace(/^\/(zh|en)(?=\/)/,'').replace(/^\/products\//,'/games/');
const routeKey=route==='/'?'':route.replace(/^\/|\/$/g,'');
const canonical=new URL(Astro.url.pathname.startsWith('/articles/')?Astro.url.pathname:`/${lang}/${routeKey}${routeKey?'/':''}`,Astro.site);
const sectionNames:Record<string,string>={games:'游戏',studio:'工作室',journal:'创作日志',contact:'联系',articles:'创作日志'};
const segments=routeKey.split('/').filter(Boolean);
const breadcrumbItems=[{name:'鹈鹕游戏',item:new URL('/zh/',Astro.site).href}];
if(segments.length){
  const section=segments[0];
  breadcrumbItems.push({name:sectionNames[section]||title.split(' — ')[0],item:new URL(section==='articles'?'/zh/journal/':`/zh/${section}/`,Astro.site).href});
  if(segments.length>1)breadcrumbItems.push({name:title.split('官网')[0].split(' — ')[0],item:canonical.href});
}
const nav=[['','首页','Home'],['games/','游戏','Games'],['studio/','工作室','Studio'],['journal/','创作日志','Journal'],['contact/','联系','Contact']];
const otherLanguage=`/${en?'zh':'en'}/${routeKey}${routeKey?'/':''}`;
const shareImage=new URL(image||(routeKey.startsWith('games/')?'/images/products/emotion-theater-cover-v2.jpg':'/images/brand/pelican-logo.jpg'),Astro.site);
---

<!DOCTYPE html>
<html lang={en?'en':'zh-CN'}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {en&&<meta name="robots" content="noindex, nofollow"/>}
    <meta name="author" content="鹈鹕游戏"/>
    <meta property="og:site_name" content="鹈鹕游戏 Pelican Games"/>
    <meta property="og:type" content="website"/>
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    <meta property="og:url" content={canonical}/>
    <meta property="og:image" content={shareImage}/>
    <meta property="og:locale" content={en?'en_US':'zh_CN'}/>
    <meta name="twitter:card" content="summary_large_image"/>
    <meta name="twitter:title" content={title}/>
    <meta name="twitter:description" content={description}/>
    <meta name="twitter:image" content={shareImage}/>
    {structuredData&&<script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g,'\\u003c')}/>}
    <meta name="keywords" content="鹈鹕游戏,情绪放映厅,情绪桌游,聚会游戏,团建游戏,内向友好" />
    <link rel="icon" type="image/jpeg" href="/images/brand/pelican-logo.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Noto+Serif+SC:wght@400;500&display=swap" rel="stylesheet" />

    {!en&&<script type="application/ld+json" set:html={JSON.stringify({
      "@context":"https://schema.org",
      "@graph":[
        {"@type":"WebSite","@id":"https://pelicangames.studio/#website","url":"https://pelicangames.studio/zh/","name":"鹈鹕游戏","alternateName":"Pelican Games","inLanguage":"zh-CN","publisher":{"@id":"https://pelicangames.studio/#organization"}},
        {"@type":"WebPage","@id":`${canonical.href}#webpage`,"url":canonical.href,"name":title,"description":description,"inLanguage":"zh-CN","isPartOf":{"@id":"https://pelicangames.studio/#website"}},
        ...(segments.length?[{"@type":"BreadcrumbList","itemListElement":breadcrumbItems.map((entry,index)=>({"@type":"ListItem","position":index+1,...entry}))}]:[])
      ]
    }).replace(/</g,'\\u003c')}/>}

    <!-- 组织信息 -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": "https://pelicangames.studio/#organization",
      "name": "鹈鹕游戏",
      "alternateName": "Pelican Games",
      "logo": "https://pelicangames.studio/images/brand/pelican-logo.jpg",
      "email": "747127623@qq.com",
      "description": "独立游戏创作工作室，从真实世界中寻找灵感",
      "url": "https://pelicangames.studio"
    })} />
</head>
<body>
    <a class="skip-link" href="#main-content">{en?'Skip to content':'跳至正文'}</a>
    <!-- 导航栏 -->
    <nav id="navbar">
        <div class="nav-container">
            <a href={`/${lang}/`} class="logo"><img class="nav-emblem" src="/images/brand/pelican-logo.jpg" alt="" width="36" height="36"/>鹈鹕游戏 <span>Pelican Games</span></a>
            <button class="hamburger" id="hamburger" aria-label={en?'Menu':'菜单'} aria-expanded="false" aria-controls="navLinks">
                <span></span><span></span><span></span>
            </button>
            <ul class="nav-links" id="navLinks">
                {nav.map(([path,zh,english])=><li><a href={`/${lang}/${path}`} aria-current={(path===''?routeKey==='':routeKey===path.slice(0,-1)||routeKey.startsWith(path))?'page':undefined}>{lang==='zh'?`${zh} ${english}`:english}</a></li>)}
                <li><a class="language-switch" href={otherLanguage} aria-label={en?'Switch to Chinese':'查看英文审核草稿'}>{en?'中文':'EN · 草稿'}</a></li>
            </ul>
        </div>
    </nav>

    {en&&<div class="translation-draft" role="note">English review draft — translations and the proposed tagline await approval. <a href={otherLanguage}>中文版</a></div>}
    <div id="main-content" tabindex="-1"><slot /></div>

    <!-- 页脚 -->
    <footer id="site-footer">
        <div class="footer-container">
            <div class="footer-brand">
                <h2>鹈鹕游戏 <span>Pelican Games</span></h2>
                <p>{en?'Play opens up possibilities':'让世界更好玩'}</p>
            </div>
            <div class="footer-links">
                <h3>{en?'Navigate':'导航'}</h3>
                <ul>{nav.map(([path,zh,english])=><li><a href={`/${lang}/${path}`}>{en?english:zh}</a></li>)}</ul>
            </div>
            <div class="footer-links">
                <h3>{en?'Contact':'联系我们'}</h3>
                <ul>
                    <li><a href="mailto:747127623@qq.com">{en?'Business email:':'商务邮箱：'}747127623@qq.com</a></li>
                    <li><a href={`/${lang}/contact/`}>{en?'Discuss a collaboration':'合作洽谈：查看合作方向'}</a></li>
                </ul>
            </div>
<div class="footer-links">
<h3>{en?'Follow us':'关注我们'}</h3>
<ul>
<li><a href="https://xhslink.cn/o/283FtkcAhhj" target="_blank" rel="noopener">{en?'Xiaohongshu:':'小红书官号：'}95020198510</a></li>
<li><a href="https://xhslink.cn/o/283FtkcAhhj" target="_blank" rel="noopener"><img class="footer-qr" src="/images/xiaohongshu-official-qr.jpg" alt={en?'Pelican Games Xiaohongshu QR code, account 95020198510':'鹈鹕游戏小红书官号二维码，账号95020198510'} width="187" height="185" loading="lazy" /></a><span class="qr-caption">{en?'Scan to follow on Xiaohongshu':'扫码关注小红书'}</span></li>
<li>{en?'WeChat official account: 鹈鹕游戏':'微信公众号：鹈鹕游戏'}</li>
<li><img class="footer-qr" src="/images/wechat-official-qr.jpg" alt={en?'Pelican Games WeChat official account QR code':'鹈鹕游戏微信公众号二维码'} width="430" height="430" loading="lazy" /><span class="qr-caption">{en?'Scan in WeChat to follow':'微信扫码关注公众号'}</span></li>
<li>{en?'WeChat ID:':'微信号：'}CartonStudio</li>
</ul>
</div>
</div>

      
        <div class="copyright">
            © 2026 Pelican Games. All rights reserved.
        </div>
    </footer>

    <script>
        document.querySelectorAll<HTMLImageElement>('img[data-fallback]').forEach(img=>{
            const fallback=()=>{const src=img.dataset.fallback;if(src){delete img.dataset.fallback;img.src=src;}};
            img.addEventListener('error',fallback,{once:true});
            if(img.complete&&img.naturalWidth===0)fallback();
        });
        // Reveal once as sections approach the viewport; content remains visible without JS.
        const motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
        const revealElements = document.querySelectorAll<HTMLElement>('[data-reveal]');
        if (!motionPreference.matches && 'IntersectionObserver' in window) {
            const observer = new IntersectionObserver(entries => entries.forEach(entry => {
                if(entry.isIntersecting){entry.target.classList.remove('reveal-pending');entry.target.classList.add('reveal-visible');observer.unobserve(entry.target);}
            }), {threshold:0.08});
            revealElements.forEach(el=>{if(el.getBoundingClientRect().top > window.innerHeight){el.classList.add('reveal-pending');observer.observe(el);}});
            motionPreference.addEventListener('change',()=>{revealElements.forEach(el=>el.classList.remove('reveal-pending'));observer.disconnect();},{once:true});
        }
        // 移动端菜单
        const hamburger = document.getElementById('hamburger');
        const navLinks = document.getElementById('navLinks');
        const mobileMenu = window.matchMedia('(max-width: 992px)');
        const setMenu = (open: boolean) => {
            hamburger?.classList.toggle('active', open);
            hamburger?.setAttribute('aria-expanded', String(open));
            navLinks?.classList.toggle('active', open);
            if (navLinks) navLinks.inert = mobileMenu.matches && !open;
        };
        setMenu(false);
        mobileMenu.addEventListener('change', () => setMenu(false));
        hamburger?.addEventListener('click', () => setMenu(hamburger.getAttribute('aria-expanded') !== 'true'));
        navLinks?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => setMenu(false)));
        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape' && hamburger?.getAttribute('aria-expanded') === 'true') {
                setMenu(false);
                hamburger.focus();
            }
        });

        // 导航滚动效果
        const navbar = document.getElementById('navbar');
        window.addEventListener('scroll', () => {
            if (window.scrollY > 50) {
                navbar?.classList.add('scrolled');
            } else {
                navbar?.classList.remove('scrolled');
            }
        });

        // 锚点使用浏览器原生导航，保留URL与键盘行为。
    </script>
</body>
</html>

<style is:global>
@layer legacy {
.skip-link{position:fixed;top:-100px;left:16px;z-index:1000;padding:12px;background:white;color:#182132}.skip-link:focus{top:16px}.nav-links a[aria-current="page"]{text-decoration:underline;text-underline-offset:7px}.language-switch{font-size:13px!important;white-space:nowrap}.translation-draft{position:relative;margin:80px auto -60px;padding:12px 24px;background:#fff5de;color:#554528;z-index:1;text-align:center;font-size:14px}.translation-draft a{text-decoration:underline}.nav-links{flex-wrap:wrap}
    * { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
        --primary: #1E293B;
        --secondary-warm: #F8F4EE;
        --secondary-gray: #E2E8F0;
        --light-bg: #F8FAFC;
        --dark-bg: #0F172A;
        --text-primary: #0F172A;
        --text-secondary: #64748B;
        --white: #FFFFFF;
        --transition: all 0.3s ease;
    }

    body {
        font-family: 'Inter', system-ui, -apple-system, 'Noto Serif SC', sans-serif;
        color: var(--text-primary);
        background-color: var(--white);
        line-height: 1.6;
        overflow-x: hidden;
    }

    /* 导航栏 */
    nav {
        position: fixed; top: 0; left: 0; width: 100%; z-index: 999;
        padding: 20px 0;
        transition: var(--transition);
        background-color: rgba(255,255,255,0.8);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(226,232,240,0.3);
    }
    nav.scrolled { box-shadow: 0 4px 20px rgba(30,41,59,0.08); padding: 16px 0; }
    .nav-container {
        max-width: 1200px; margin: 0 auto; padding: 0 24px;
        display: flex; justify-content: space-between; align-items: center;
    }
    .logo { font-size: 20px; font-weight: 400; color: var(--primary); letter-spacing: 0.5px; text-decoration: none; }
    .logo span { font-weight: 300; color: var(--text-secondary); }
    .nav-links { display: flex; gap: 40px; list-style: none; }
    .nav-links a { text-decoration: none; color: var(--text-primary); font-weight: 400; transition: var(--transition); position: relative; }
    .nav-links a:hover { color: var(--primary); }
    .nav-links a::after { content: ''; position: absolute; bottom: -4px; left: 0; width: 0; height: 1px; background: var(--primary); transition: var(--transition); }
    .nav-links a:hover::after { width: 100%; }
    .hamburger { display: none; flex-direction: column; gap: 5px; align-items: center; justify-content: center; width: 44px; height: 44px; cursor: pointer; background: none; border: none; }
    .hamburger span { width: 24px; height: 1px; background: var(--primary); transition: var(--transition); display: block; }

    html { scroll-padding-top: 100px; scroll-behavior: smooth; }
    a:focus-visible, button:focus-visible, summary:focus-visible { outline: 3px solid var(--primary); outline-offset: 5px; }
    @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { transition: none !important; animation: none !important; }
    }
    /* 通用 */
    .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
    .section { padding: 120px 0; }
    .section-title { font-size: 36px; font-weight: 300; color: var(--primary); margin-bottom: 16px; position: relative; display: inline-block; }
    .section-title::after { content: ''; position: absolute; bottom: -8px; left: 0; width: 40px; height: 1px; background: var(--primary); }
    .section-desc { font-size: 16px; color: var(--text-secondary); margin-bottom: 60px; max-width: 600px; }
    .fade-in { opacity: 1; transform: none; }
    .fade-in.active { opacity: 1; transform: translateY(0); }

    /* 按钮 */
    .btn { padding: 12px 32px; border-radius: 8px; text-decoration: none; font-weight: 400; transition: var(--transition); display: inline-block; cursor: pointer; border: none; font-size: 16px; }
    .btn-primary { background: var(--primary); color: var(--white); }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 10px 20px rgba(30,41,59,0.15); }
    .btn-secondary { background: transparent; color: var(--primary); border: 1px solid var(--primary); }
    .btn-secondary:hover { background: var(--primary); color: var(--white); transform: translateY(-2px); }

    /* Hero */
    .hero {
        min-height: 100vh; display: flex; align-items: center; justify-content: center;
        text-align: center; padding-top: 80px;
        background: linear-gradient(180deg, var(--white) 0%, var(--light-bg) 100%);
        position: relative; overflow: hidden;
    }
    .hero-content { position: relative; z-index: 1; max-width: 800px; }
    .hero h1 { font-size: 48px; font-weight: 300; color: var(--primary); margin-bottom: 16px; letter-spacing: 1px; }
    .hero p { font-size: 18px; color: var(--text-secondary); margin-bottom: 40px; font-weight: 300; line-height: 1.8; }
    .btn-group { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }

    /* 作品卡片 */
    .works-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 24px; margin-bottom: 24px; }
    .works-grid-secondary { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    .work-card { border-radius: 12px; overflow: hidden; background: var(--white); border: 1px solid var(--secondary-gray); transition: var(--transition); }
    .work-card:hover { transform: translateY(-4px); box-shadow: 0 15px 30px rgba(30,41,59,0.1); border-color: transparent; }
    .work-img { width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: contain; display: block; }
    .work-card-secondary .work-img { height: 280px; }
    .work-content { padding: 24px; }
    .work-tags { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 12px; }
    .tag { padding: 4px 12px; border-radius: 100px; font-size: 12px; font-weight: 400; background: var(--light-bg); color: var(--text-secondary); }
    .tag.online { background: var(--secondary-warm); color: var(--primary); }
    .tag.wip { background: var(--secondary-gray); color: var(--primary); }
    .work-title { font-size: 24px; font-weight: 400; color: var(--primary); margin-bottom: 12px; }
    .work-desc { font-size: 16px; color: var(--text-secondary); margin-bottom: 20px; line-height: 1.7; }

    /* 关于 */
    .about-section { background-color: var(--light-bg); }
    .about-wrap { display: grid; grid-template-columns: 3fr 2fr; gap: 60px; align-items: center; }
    .about-text p { font-size: 16px; color: var(--text-primary); line-height: 2; margin-bottom: 20px; font-weight: 300; }
    .about-img { width: 100%; border-radius: 12px; opacity: 0.8; }

    /* 商务合作 */
    .business-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 24px; margin-bottom: 60px; }
    .business-card { padding: 32px 24px; border-radius: 12px; background: var(--white); border: 1px solid var(--secondary-gray); transition: var(--transition); }
    .business-card:hover { border-color: var(--primary); transform: translateY(-2px); }
    .business-title { font-size: 20px; font-weight: 400; color: var(--primary); margin-bottom: 12px; }
    .business-desc { font-size: 15px; color: var(--text-secondary); line-height: 1.7; }
    .business-contact { text-align: center; padding: 40px; background: var(--secondary-warm); border-radius: 12px; }
    .business-contact h3 { font-size: 24px; font-weight: 400; color: var(--primary); margin-bottom: 16px; }
    .business-contact .email { font-size: 20px; font-weight: 400; color: var(--primary); margin-bottom: 24px; letter-spacing: 0.5px; }

    /* 动态 */
    .news-list { display: flex; flex-direction: column; gap: 16px; }
    .news-item { padding: 20px; border-radius: 8px; border-bottom: 1px solid var(--secondary-gray); transition: var(--transition); cursor: pointer; }
    .news-item:hover { background-color: var(--light-bg); }
    .news-date { font-size: 14px; color: var(--text-secondary); margin-bottom: 8px; }
    .news-title { font-size: 16px; font-weight: 400; color: var(--primary); }

    /* FAQ */
    .faq { max-width: 800px; margin: 0 auto; }
    .faq-item { border-bottom: 1px solid var(--secondary-gray); padding: 24px 0; cursor: pointer; }
    .faq-item:first-child { border-top: 1px solid var(--secondary-gray); }
    .faq-item summary { list-style: none; font-size: 18px; font-weight: 400; color: var(--primary); margin-bottom: 12px; position: relative; padding-right: 30px; }
    .faq-item summary::after { content: '+'; position: absolute; right: 0; top: 0; color: var(--text-secondary); font-weight: 300; transition: transform 0.3s ease; }
    .faq-item p { font-size: 16px; color: var(--text-secondary); line-height: 1.8; font-weight: 300;  }
    .faq-item summary::-webkit-details-marker { display: none; }
    .faq-item[open] summary::after { transform: rotate(45deg); }

    /* 文章列表 */
    .article-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 24px; }
    .article-card { border-radius: 12px; overflow: hidden; background: var(--white); border: 1px solid var(--secondary-gray); transition: var(--transition); text-decoration: none; color: inherit; }
    .article-card:hover { transform: translateY(-4px); box-shadow: 0 15px 30px rgba(30,41,59,0.1); border-color: transparent; }
    .article-cover { width: 100%; height: 200px; object-fit: cover; }
    .article-body { padding: 24px; }
    .article-category { font-size: 12px; color: var(--text-secondary); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 8px; }
    .article-title { font-size: 20px; font-weight: 400; color: var(--primary); margin-bottom: 8px; }
    .article-excerpt { font-size: 14px; color: var(--text-secondary); line-height: 1.7; }
    .article-date { font-size: 12px; color: var(--text-secondary); margin-top: 12px; }

    /* 文章详情 */
    .article-detail { max-width: 800px; margin: 0 auto; padding-top: 120px; }
    .article-detail h1 { font-size: 36px; font-weight: 400; color: var(--primary); margin-bottom: 16px; line-height: 1.4; }
    .article-meta { font-size: 14px; color: var(--text-secondary); margin-bottom: 40px; }
    .article-detail .prose { line-height: 1.9; color: var(--text-primary); }
    .article-detail .prose h2 { font-size: 24px; font-weight: 400; margin: 40px 0 16px; color: var(--primary); }
    .article-detail .prose h3 { font-size: 20px; font-weight: 400; margin: 32px 0 12px; color: var(--primary); }
    .article-detail .prose p { margin-bottom: 20px; font-size: 16px; }
    .article-detail .prose img { border-radius: 8px; margin: 24px 0; max-width: 100%; }
    .article-detail .prose a { color: var(--primary); text-decoration: underline; }
    .article-detail .prose blockquote { border-left: 3px solid var(--secondary-gray); padding-left: 20px; margin: 24px 0; color: var(--text-secondary); font-style: italic; }
    .article-detail .prose ul, .article-detail .prose ol { margin: 16px 0; padding-left: 24px; }
    .article-detail .prose li { margin-bottom: 8px; }
    .article-detail .prose .video-embed { position: relative; padding-bottom: 56.25%; height: 0; margin: 24px 0; border-radius: 8px; overflow: hidden; }
    .article-detail .prose .video-embed iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none; }

    /* 页脚 */
    footer { background-color: var(--dark-bg); color: var(--white); padding: 60px 0 30px; }
    .footer-container { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px; margin-bottom: 40px; }
    .footer-brand h2 { font-size: 24px; font-weight: 300; margin-bottom: 12px; }
    .footer-brand h2 span { font-weight: 300; color: rgba(255,255,255,0.6); }
    .footer-brand p { color: rgba(255,255,255,0.6); font-size: 14px; }
    .footer-qr { display: block; width: 150px; height: auto; margin: 4px 0 8px; }
    .qr-caption { font-size: 13px; color: rgba(255,255,255,0.7); }
    .footer-links a { overflow-wrap: anywhere; }
    .footer-links h3 { font-size: 16px; font-weight: 400; margin-bottom: 16px; }
    .footer-links ul { list-style: none; display: flex; flex-direction: column; gap: 12px; }
    .footer-links a { color: rgba(255,255,255,0.6); text-decoration: none; transition: var(--transition); font-size: 14px; }
    .footer-links a:hover { color: var(--white); }
    .copyright { text-align: center; padding-top: 30px; border-top: 1px solid rgba(255,255,255,0.1); color: rgba(255,255,255,0.4); font-size: 14px; }

    /* 响应式 */
    @media (max-width: 992px) {
        .nav-links { position: fixed; top: 70px; left: -100%; width: 100%; height: calc(100vh - 70px); background: var(--white); flex-direction: column; align-items: center; justify-content: flex-start; padding-top: 60px; gap: 30px; transition: var(--transition); }
