---
import BaseLayout from '../layouts/BaseLayout.astro';
import {getCollection} from 'astro:content';
const {lang='zh'}=Astro.props;
const en=lang==='en';
const product=(await getCollection('products')).find(p=>p.data.status==='online');
const news=(await getCollection('news')).sort((a,b)=>a.data.order-b.data.order).slice(0,3);
const base=`/${lang}`;
---
<BaseLayout lang={lang} title={en?'Pelican Games — Independent tabletop games':'鹈鹕游戏 — 独立桌游创作工作室'} description={en?'Original tabletop games inspired by real-world behavior, relationships and patterns.':'鹈鹕游戏是一家独立游戏创作工作室。从真实世界中寻找灵感，用游戏创造值得经历的体验。'}>
<main class="brand-home">
<section class="brand-stage" aria-labelledby="brand-title">
 <div class="brand-sticky">
  <div class="brand-orbit" aria-hidden="true"></div>
  <div class="brand-lockup">
   <img class="hero-emblem" src="/images/brand/pelican-logo.jpg" alt={en?'Pelican Games logo':'鹈鹕游戏标志'} width="693" height="704" fetchpriority="high" />
   <p class="brand-wordmark">PELICAN GAMES</p>
   <h1 id="brand-title">{en?'Play opens up possibilities':'让世界更好玩'}</h1>
   <p class="brand-caption">{en?'Independent tabletop games':'独立桌游创作工作室'}</p>
  </div>
  <a class="discover" href="#works"><span>{en?'Scroll to discover':'往下，开始探索'}</span><span aria-hidden="true">↓</span></a>
 </div>
</section>
<section class="section container" id="works">
 <div class="chapter-head" data-reveal><p class="chapter-index">01 / GAMES</p><h2>{en?'Our games':'我们的作品'}</h2><a class="text-link" href={`${base}/games/`}>{en?'All games':'全部作品'} <span>↗</span></a></div>
 {product&&<article class="feature-game" data-reveal>
  <a class="feature-image" href={`${base}/games/${product.id}/`} aria-label={en?'Explore The Feeling Theater':'了解《情绪放映厅》'}><img src="/images/products/emotion-theater-components.jpg" alt={en?'The Feeling Theater components':'《情绪放映厅》配件实物'} width="1600" height="1067" loading="lazy"/><span class="image-corner">THE FEELING THEATER <span aria-hidden="true">↗</span></span></a>
  <div class="feature-caption"><div><p class="eyebrow"><span class="status-dot"></span>{en?'Published':'已发行'} · {en?'1–6 players / 45 min / Ages 14+':'1–6人 / 45分钟 / 14+'}</p><h3>{en?'The Feeling Theater':'情绪放映厅'}</h3><p>{en?'A party game that brings feelings into view.':product.data.tagline}</p></div><a class="round-link" href={`${base}/games/${product.id}/`} aria-label={en?'Explore the game':'了解游戏'}>↗</a></div>
 </article>}
 <div class="development-strip" id="development" data-reveal><div><p class="chapter-index">IN DEVELOPMENT</p><h3>{en?'In development':'研发中'}</h3></div><a href={`${base}/games/#development`}><span>风险投资</span><span>蜡烛人</span><span aria-hidden="true">↗</span></a></div>
</section>
<section class="section studio-home" id="about"><div class="container studio-grid" data-reveal><div><p class="chapter-index">02 / STUDIO</p><h2>{en?'The studio':'关于鹈鹕'}</h2><p class="studio-motto">{en?'It all begins\nwith play.':'好玩，\n是一切的开始'}</p></div><div class="studio-note"><p>{en?'We are an independent game creation studio.':'鹈鹕游戏是一家独立游戏创作工作室。'}</p><p>{en?'We find inspiration in the real world and create experiences through games.':'我们从真实世界中寻找灵感，用游戏创造值得经历的体验'}</p><a class="text-link" href={`${base}/studio/`}>{en?'Meet the studio':'认识我们'} <span>↗</span></a></div></div></section>
<section class="section container" id="news"><div class="chapter-head" data-reveal><p class="chapter-index">03 / JOURNAL</p><h2>{en?'Journal':'创作日志'}</h2><a class="text-link" href={`${base}/journal/`}>{en?'All entries':'全部记录'} <span>↗</span></a></div><div class="event-list">{news.map(n=><article data-reveal><p class="eyebrow">{n.data.date}</p><div><h3>{en?(n.id==='guangzhou-bgm-2026'?'Guangzhou BGM tabletop game exhibition':'The Feeling Theater released'):n.data.title}</h3>{n.data.detail&&<p>{en?'Read the original Chinese record.':n.data.detail.slice(0,100)}</p>}</div><a class="text-link" href={n.data.detail?`/zh/journal/${n.id}/`:`${base}/journal/#${n.id}`} aria-label={`${en?'View record:':'查看记录：'}${n.data.title}`}>↗</a></article>)}</div></section>
<section class="section contact-home" id="business"><div class="container" data-reveal><p class="chapter-index">04 / CONTACT</p><h2>{en?'Create more\npossibilities together':'一起创造\n更多可能'}</h2><div class="contact-bottom"><p>{en?'We welcome conversations about publishing, retail and creative collaborations.':'我们欢迎你的到来。无论是游戏发行、出版商、渠道销售、活动组织者，还是跨领域的创意合作，都期待与你交流。'}</p><a class="btn btn-primary" href={`${base}/contact/`}>{en?'Get in touch':'联系我们'} <span aria-hidden="true">↗</span></a></div></div></section>
</main>
</BaseLayout>
<script>
const stage=document.querySelector<HTMLElement>('.brand-stage');
const reduced=window.matchMedia('(prefers-reduced-motion: reduce)');
let queued=false;
const render=()=>{queued=false;if(!stage)return;const progress=reduced.matches?0:Math.min(1,Math.max(0,-stage.getBoundingClientRect().top/(window.innerHeight*.75)));stage.style.setProperty('--journey',String(progress));};
const request=()=>{if(!queued){queued=true;requestAnimationFrame(render);}};
window.addEventListener('scroll',request,{passive:true});window.addEventListener('resize',request);reduced.addEventListener('change',request);render();
</script>
<style>
.section.container{padding-inline:32px}.brand-stage{height:140svh;position:relative;--journey:0}.brand-sticky{position:sticky;top:0;height:100svh;min-height:650px;display:flex;align-items:center;justify-content:center;overflow:hidden}.brand-lockup{position:relative;z-index:1;text-align:center;transform:translateY(calc(var(--journey)*-70px)) scale(calc(1 - var(--journey)*.24));opacity:calc(1 - var(--journey)*.65);will-change:transform;animation:brand-arrive 1.2s cubic-bezier(.2,.8,.2,1) backwards}.hero-emblem{display:block;width:clamp(190px,30vh,310px);height:auto;margin:0 auto 22px;box-shadow:0 24px 80px #001d2366;transform:rotate(-4deg)}.brand-wordmark{font-size:12px;font-weight:700;letter-spacing:.32em;color:var(--text-secondary)}.brand-lockup h1{font-size:clamp(38px,6.5vw,88px);line-height:1.18;letter-spacing:-.04em;margin:18px 24px;font-weight:800}.brand-caption{color:var(--text-secondary);font-size:14px;letter-spacing:.16em}.brand-orbit{position:absolute;width:1000px;height:700px;border-radius:50%;background:radial-gradient(ellipse,#007f7666,transparent 65%);filter:blur(35px);animation:ambient-drift 16s ease-in-out infinite alternate;pointer-events:none}.discover{position:absolute;bottom:35px;display:flex;align-items:center;gap:20px;font-size:12px;letter-spacing:.08em;text-decoration:none!important;color:var(--text-secondary)}.discover span:last-child{font-size:26px;color:var(--primary);animation:nudge 2.8s ease-in-out infinite}.chapter-head{display:grid;grid-template-columns:1fr auto;align-items:end;gap:14px;margin-bottom:44px}.chapter-index{font-size:11px;letter-spacing:.18em;color:var(--primary);font-weight:600}.chapter-head .chapter-index{grid-column:1/-1}.chapter-head h2,.studio-grid h2{font-size:clamp(30px,4vw,48px);letter-spacing:-.03em;font-weight:700}.text-link{display:inline-flex;align-items:center;gap:24px;font-size:14px;text-decoration:none}.text-link span{display:inline-block;transition:transform .3s}.text-link:hover span{transform:translate(3px,-3px)}.feature-image{display:block;position:relative;overflow:hidden;border-radius:6px;background:#e9e3d7}.feature-image img{display:block;width:100%;height:auto;max-height:680px;object-fit:cover;transition:transform 1s cubic-bezier(.2,.7,.2,1)}.feature-image:hover img{transform:scale(1.035)}.image-corner{position:absolute;bottom:24px;left:24px;right:24px;display:flex;justify-content:space-between;font-size:11px;letter-spacing:.14em;color:white;text-shadow:0 1px 8px #000;background:#002f32cc;padding:14px 18px;border-radius:3px}.feature-caption{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:30px 0}.feature-caption h3{font-size:clamp(28px,4vw,46px);font-weight:650;margin:10px 0}.feature-caption p{color:var(--text-secondary)}.eyebrow{font-size:12px;letter-spacing:.03em;color:var(--text-secondary)}.status-dot{display:inline-block;width:6px;height:6px;background:var(--primary);border-radius:50%;margin-right:8px}.round-link{display:grid;place-items:center;width:62px;height:62px;flex-shrink:0;border:1px solid #f8b91766;border-radius:50%;color:var(--primary);font-size:28px;text-decoration:none;transition:background .3s,color .3s}.round-link:hover{background:var(--primary);color:var(--dark-bg)}.development-strip{border-top:1px solid var(--secondary-gray);margin-top:42px;padding-top:32px;display:flex;justify-content:space-between;gap:28px}.development-strip h3{font-size:21px;margin-top:8px}.development-strip>a{display:flex;align-items:center;gap:40px;text-decoration:none;font-size:20px}.development-strip>a span:last-child{color:var(--primary)}.studio-home{background:#007f7618;border-block:1px solid var(--secondary-gray)}.studio-grid{display:grid;grid-template-columns:1fr 1fr;gap:90px}.studio-grid h2{margin-top:14px}.studio-motto{white-space:pre-line;font-weight:700;font-size:clamp(36px,5vw,68px);line-height:1.4;letter-spacing:-.04em;margin-top:56px}.studio-note{align-self:end;padding-bottom:8px}.studio-note p{font-size:19px;line-height:1.9;color:var(--text-secondary);margin:0 0 24px}.studio-note .text-link{margin-top:20px}.event-list article{display:grid;grid-template-columns:120px 1fr auto;gap:28px;align-items:center;padding:32px 0;border-top:1px solid var(--secondary-gray)}.event-list article:last-child{border-bottom:1px solid var(--secondary-gray)}.event-list h3{font-size:clamp(20px,2.2vw,28px);font-weight:500}.event-list .text-link{font-size:28px;color:var(--primary);padding:8px}.contact-home{background:#00766d24;border-top:1px solid var(--secondary-gray)}.contact-home h2{font-size:clamp(42px,7vw,90px);white-space:pre-line;line-height:1.25;margin:28px 0 44px;letter-spacing:-.04em;font-weight:700}.contact-bottom{display:flex;align-items:end;justify-content:space-between;gap:60px}.contact-bottom p{max-width:670px;color:var(--text-secondary);line-height:1.9}.contact-bottom .btn{flex-shrink:0}.contact-bottom .btn span{margin-left:28px}
@keyframes brand-arrive{from{opacity:0;translate:0 30px}to{opacity:1;translate:0 0}}@keyframes ambient-drift{to{transform:translate(90px,-40px) rotate(25deg) scale(1.1)}}@keyframes nudge{50%{transform:translateY(6px)}}
@media(max-width:768px){.section.container{padding-inline:24px}.brand-stage{height:120svh}.brand-sticky{min-height:580px}.hero-emblem{width:210px}.brand-lockup h1{font-size:42px}.chapter-head{gap:16px}.chapter-head .text-link{font-size:12px}.feature-caption{padding-top:24px}.round-link{width:48px;height:48px}.image-corner{bottom:12px;left:12px;right:12px;font-size:9px}.development-strip{flex-direction:column}.development-strip>a{justify-content:space-between;font-size:20px;gap:16px}.studio-grid{grid-template-columns:1fr;gap:32px}.studio-motto{margin-top:32px}.studio-note p{font-size:17px}.event-list article{grid-template-columns:1fr auto;gap:12px}.event-list .eyebrow{grid-column:1/-1}.contact-bottom{flex-direction:column;align-items:start;gap:28px}.contact-home h2{font-size:48px}.brand-wordmark{font-size:10px}.discover{bottom:25px}}
@media(prefers-reduced-motion:reduce){.brand-stage{height:100svh;min-height:580px}.brand-sticky{position:relative}.brand-lockup{transform:none;opacity:1;animation:none}.brand-orbit,.discover span:last-child{animation:none}.feature-image:hover img{transform:none}}
</style>
