---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map(product => ({
    params: { slug: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const { Content } = await render(product);

const statusLabels: Record<string, string> = {
  online: '已上线',
  wip: '研发中',
  planned: '规划中',
};
---

<BaseLayout title={`《${product.data.name}》- 鹈鹕游戏`} description={product.data.tagline}>
    <div class="container product-detail">
        <div class="product-hero">
            <img src={product.data.image} alt={`${product.data.name}盒装实物`} class="product-hero-img" width="1600" height="1067" fetchpriority="high" decoding="async" />
            <div class="product-hero-overlay">
                <div class="product-badge-row">
                    <span class={`tag ${product.data.status}`}>{statusLabels[product.data.status]}</span>
                    {product.data.tags.map(tag => <span class="tag">{tag}</span>)}
                </div>
                <h1>《{product.data.name}》</h1>
                {product.data.tagline && <p class="tagline">{product.data.tagline}</p>}
            </div>
        </div>

        <div class="product-info-bar">
            {product.data.price && (
            <div class="info-item">
                <span class="info-label">价格</span>
                <span class="info-value price">{product.data.price}</span>
            </div>
            )}
            {product.data.players && (
            <div class="info-item">
                <span class="info-label">人数</span>
                <span class="info-value">{product.data.players}</span>
            </div>
            )}
            {product.data.duration && (
            <div class="info-item">
                <span class="info-label">时长</span>
                <span class="info-value">{product.data.duration}</span>
            </div>
            )}
        </div>

        {product.data.age && <p class="age-note">建议年龄：{product.data.age}</p>}
        <div class="product-actions-bar">
            {product.data.buyLink && (
            <a href={product.data.buyLink} class="btn btn-primary">立即购买</a>
            )}
            {product.data.rulebook && <a href="#rulebook-title" class="btn btn-secondary">玩法与规则</a>}
            {product.data.videos.length > 0 && <a href="#video-title" class="btn btn-secondary">教学与试玩</a>}
            {product.data.detailLink && product.data.detailLink !== '#' && (
            <a href={product.data.detailLink} class="btn btn-secondary">了解更多</a>
            )}
            <a href="/#works" class="btn btn-secondary">返回作品列表</a>
        </div>

        <div class="prose" style="margin-top: 48px;">
            <Content />
        </div>

        {product.data.rulebook && (
        <section class="rulebook" aria-labelledby="rulebook-title">
            <h2 id="rulebook-title">原版规则书</h2>
            <p>多人玩法、计分和配件清单。PDF 共 4 页，约 6 MB。</p>
            <div class="product-actions-bar">
                <a href={product.data.rulebook} class="btn btn-primary" target="_blank" rel="noopener">查看规则书</a>
                <a href={product.data.rulebook} class="btn btn-secondary" download>下载规则书</a>
            </div>
        </section>
        )}

        {product.data.gallery.length > 0 && (
        <section class="product-gallery" aria-labelledby="gallery-title">
            <h2 id="gallery-title">实物展示</h2>
            <div class="gallery-grid">
                {product.data.gallery.map(photo => (
                <figure>
                    <img src={photo.image} alt={photo.caption} width="1600" height="1067" loading="lazy" decoding="async" />
                    <figcaption>{photo.caption}</figcaption>
                </figure>
                ))}
            </div>
        </section>
        )}

        {product.data.videos.length > 0 && (
        <section class="product-videos" aria-labelledby="video-title">
            <h2 id="video-title">教学与试玩</h2>
            <div class="video-list">
                {product.data.videos.map(video => (
                <a class="video-link" href={video.url} target="_blank" rel="noopener">
                    <h3>{video.title}</h3>
                    <span class="video-action">在 B 站观看 ↗</span>
                </a>
                ))}
            </div>
        </section>
        )}

        {product.data.buyLink && (
        <div class="product-final-purchase">
            <a href={product.data.buyLink} class="btn btn-primary">立即购买</a>
        </div>
        )}

        <div style="margin-top: 60px; padding-top: 30px; border-top: 1px solid var(--secondary-gray);">
            <a href="/#works" class="btn btn-secondary">← 返回作品列表</a>
        </div>
    </div>
</BaseLayout>

<style>
    .prose :global(.introduction-images) { display: grid; gap: 0; }
    .prose :global(.introduction-images img) { display: block; width: 100%; height: auto; margin: 0; border-radius: 0; }

    .product-detail { padding-top: 100px; max-width: 900px; }
    .product-hero { position: relative; border-radius: 12px; overflow: hidden; margin-bottom: 32px; }
    .product-hero-img { width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: contain; display: block; }
    .product-hero-overlay { padding: 24px 32px; background: var(--dark-bg); color: white; }
    .product-hero-overlay h1 { font-size: 32px; font-weight: 400; margin-top: 8px; letter-spacing: 0.05em; }
    .tagline { font-size: 16px; opacity: 0.8; margin-top: 8px; }
    .product-badge-row { display: flex; gap: 8px; flex-wrap: wrap; }
    .tag { padding: 4px 12px; border-radius: 100px; font-size: 12px; background: rgba(255,255,255,0.2); color: white; }
    .tag.online { background: rgba(248,244,238,0.3); color: white; }
    .tag.wip { background: rgba(226,232,240,0.3); color: white; }

    .product-info-bar { display: flex; gap: 32px; padding: 24px 0; border-bottom: 1px solid var(--secondary-gray); margin-bottom: 24px; }
    .info-item { display: flex; flex-direction: column; gap: 4px; }
    .info-label { font-size: 12px; color: var(--text-secondary); letter-spacing: 0.1em; }
    .info-value { font-size: 18px; color: var(--text-primary); }
    .info-value.price { color: var(--primary); font-weight: 500; }

    .product-actions-bar { display: flex; gap: 16px; flex-wrap: wrap; }
    .age-note { margin-bottom: 20px; color: var(--text-secondary); }
    .product-videos { margin-top: 40px; }
    .product-videos h2 { font-size: 24px; font-weight: 400; margin-bottom: 12px; }
    .video-intro { color: var(--text-secondary); margin-bottom: 24px; }
    .video-list { display: grid; gap: 16px; }
    .video-link { padding: 20px 24px; display: block; text-decoration: none; border: 1px solid var(--secondary-gray); border-radius: 8px; color: var(--text-primary); }
    .video-link:hover { border-color: var(--primary); }
    .product-final-purchase { margin-top: 40px; padding: 32px 0; text-align: center; }
    .product-final-purchase .btn { min-width: 200px; }
    .video-link h3 { font-size: 18px; font-weight: 500; margin: 8px 0 12px; overflow-wrap: anywhere; }
    .video-action { font-size: 14px; color: var(--primary); }
    .product-info-bar { flex-wrap: wrap; }
    .rulebook { padding: 24px; margin-top: 32px; background: var(--light-bg); border-radius: 8px; }
    .rulebook h2 { font-size: 24px; font-weight: 400; margin-bottom: 12px; }
    .rulebook p { color: var(--text-secondary); margin-bottom: 20px; }
    .prose :global(h2) { font-size: 24px; font-weight: 400; margin: 32px 0 16px; }
    .prose :global(h3) { font-size: 18px; margin: 24px 0 12px; }
    .prose :global(ol), .prose :global(ul) { padding-left: 24px; margin: 16px 0; }
    .prose :global(li) { margin-bottom: 8px; }

    .product-gallery { margin-top: 48px; }
    .product-gallery h2 { font-size: 24px; font-weight: 400; margin-bottom: 24px; }
    .gallery-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
    .gallery-grid img { display: block; width: 100%; height: auto; border-radius: 8px; }
    .gallery-grid figcaption { font-size: 14px; margin-top: 8px; color: var(--text-secondary); }
    .prose { line-height: 1.9; }
    .prose :global(p) { margin-bottom: 16px; }
    @media (max-width: 768px) {
        .gallery-grid { grid-template-columns: 1fr; }
        .product-hero-overlay { padding: 24px 20px 20px; }
        .product-hero-overlay h1 { font-size: 24px; }
        .product-info-bar { gap: 20px; }
    }
</style>
