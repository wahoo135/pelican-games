---
export const prerender=true;
import Product from '../../components/Product.astro';
import {getCollection} from 'astro:content';
export async function getStaticPaths(){return (await getCollection('products')).map(product=>({params:{slug:product.id},props:{product}}));}
const {product}=Astro.props;
---
<Product product={product} lang="zh"/>
