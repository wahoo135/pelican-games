---
export const prerender = true;
import { getCollection } from 'astro:content';
export async function getStaticPaths() {
 return (await getCollection('news')).map(item => ({params:{slug:item.id},props:{item}}));
}
const {item}=Astro.props;
return Astro.redirect(item.data.detail ? `/zh/journal/${item.id}/` : `/zh/journal/#${item.id}`,301);
---
