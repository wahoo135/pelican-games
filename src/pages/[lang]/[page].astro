---
export const prerender=true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import {getCollection} from 'astro:content';
import {studioCopy,cooperation} from '../../lib/copy';
export function getStaticPaths(){return ['zh','en'].flatMap(lang=>['games','studio','journal','contact'].map(page=>({params:{lang,page}})));}
const lang=Astro.params.lang as 'zh'|'en';const en=lang==='en';const page=Astro.params.page;const base=`/${lang}`;
const titles={games:en?'Games':'游戏',studio:en?'Studio':'工作室',journal:en?'Journal':'创作日志',contact:en?'Contact':'联系'};
const title=titles[page as keyof typeof titles];
const descriptions={games:en?'Published and in-development tabletop games by Pelican Games.':'鹈鹕游戏已发行及研发中的原创桌游作品。',studio:en?'Our approach to creating games and experiences.':'认识鹈鹕游戏的创作理念与探索。',journal:en?'Release notes and studio events, with their original dates.':'鹈鹕游戏的发行记录、展会活动与创作日志。',contact:en?'Contact Pelican Games about publishing, retail and creative collaborations.':'联系鹈鹕游戏，交流出版发行、零售渠道与创意合作。'};
const products=(await getCollection('products')).sort((a,b)=>a.data.order-b.data.order);
const news=(await getCollection('news')).sort((a,b)=>a.data.order-b.data.order);
const articles=await getCollection('articles');
---
<BaseLayout lang={lang} title={`${title} — ${en?'Pelican Games':'鹈鹕游戏'}`} description={descriptions[page as keyof typeof descriptions]}>
<main class="container hub"><h1 class="section-title">{title}</h1>
{page==='games'&&<><h2>{en?'Published':'已发行'}</h2><div class="cards">{products.filter(p=>p.data.status==='online').map(p=><article class="game-card"><a href={`${base}/games/${p.id}/`}><img src={p.data.image} data-fallback="/images/products/emotion-theater-components.jpg" alt={en?'The Feeling Theater game box':`${p.data.name}盒装实物`} width="1600" height="1067"/><h3>{en?'The Feeling Theater':`《${p.data.name}》`}</h3></a><p>{en?'A party game that brings feelings into view.':p.data.tagline}</p><p>{en?'1–6 players · 45 min · Ages 14+':'1–6人 · 45分钟 · 14+'}</p><a class="btn btn-primary" href={`${base}/games/${p.id}/`}>{en?'Explore the game':'了解游戏'}</a></article>)}</div><section id="development"><h2>{en?'In development':'研发中'}</h2><div class="cards">{['风险投资','蜡烛人'].map(name=><article class="plain-card"><p class="muted">{en?'In development':'研发中'}</p><h3>《{name}》</h3>{en&&<p class="muted">Chinese working title</p>}</article>)}</div></section></>}
{page==='studio'&&<div class="text-body">{studioCopy[lang].map(text=><p>{text}</p>)}</div>}
{page==='journal'&&<><p class="intro">{en?'Notes from our releases, events and creative work.':'记录作品发行、参展与创作的经过。'}</p><div class="journal-list">{news.map(n=><article id={n.id}><p class="muted">{n.data.date} · {en?'Studio news':'工作室动态'}</p><h2>{en?(n.id==='guangzhou-bgm-2026'?'Guangzhou BGM tabletop game exhibition':'The Feeling Theater released'):n.data.title}</h2>{n.data.detail?<><p>{en?'This record is currently available in Chinese.':n.data.detail.slice(0,160)}</p><a href={`/zh/journal/${n.id}/`}>{en?'Read the Chinese record →':'阅读完整记录 →'}</a></>:n.data.link&&<a href={`${base}/games/emotion-theater/`}>{en?'Explore the game →':'了解作品 →'}</a>}</article>)}{articles.map(a=><article><p class="muted">{a.data.publishedAt}</p><h2>{a.data.title}</h2>{a.data.excerpt&&<p>{a.data.excerpt}</p>}<a href={`/articles/${a.id}`}>{en?'Read in Chinese →':'阅读全文 →'}</a></article>)}</div></>}
{page==='contact'&&<><h2>{en?'Create more possibilities together':'一起创造更多可能'}</h2><p class="intro">{en?'We welcome you. Whether your work involves publishing, distribution, retail, events or cross-disciplinary creative projects, we look forward to a conversation.':'我们欢迎你的到来。无论是游戏发行、出版商、渠道销售、活动组织者，还是跨领域的创意合作，都期待与你交流。'}</p><div class="cards directions">{cooperation[lang].map(([h,p])=><article class="plain-card"><h3>{h}</h3><p>{p}</p></article>)}</div><section class="contact-block"><h2>{en?'Get in touch':'联系我们'}</h2><p><a href="mailto:747127623@qq.com?subject=Pelican%20Games%20-%20Cooperation">747127623@qq.com</a> <button class="copy-control" data-copy="747127623@qq.com">{en?'Copy email':'复制邮箱'}</button></p><p>{en?'Phone':'电话'}：<a href="tel:15986894004">15986894004</a></p><p>{en?'WeChat':'微信号'}：CartonStudio <button class="copy-control" data-copy="CartonStudio">{en?'Copy ID':'复制微信号'}</button></p><p>{en?'For general questions or media materials, please contact us by email.':'一般咨询、媒体资料需求，也欢迎通过邮件与我们联系。'}</p><span class="copy-result" role="status" aria-live="polite"></span></section></>}
</main>
</BaseLayout>
<script>
document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(button=>button.addEventListener('click',async()=>{const status=document.querySelector('.copy-result');try{await navigator.clipboard.writeText(button.dataset.copy||'');if(status)status.textContent=document.documentElement.lang==='en'?'Copied.':'已复制';}catch{if(status)status.textContent=document.documentElement.lang==='en'?'Please select and copy the text above.':'请选中上方文字手动复制';}}));
</script>
<style>
.hub{padding-top:130px;padding-bottom:80px;min-height:60vh}.hub>h2,.hub section>h2{margin:40px 0 24px;font-size:28px;font-weight:400}.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.game-card,.plain-card{border:1px solid var(--secondary-gray);border-radius:12px;padding:28px}.game-card img{width:100%;height:auto;aspect-ratio:3/2;object-fit:contain;margin-bottom:24px}.cards h3{font-size:24px;margin-bottom:16px;font-weight:400}.cards p{margin:16px 0}.game-card .btn{margin-top:12px}.intro,.text-body{max-width:850px;line-height:1.9;font-size:19px}.text-body p{margin-bottom:28px}.muted{color:var(--text-secondary);font-size:14px}.journal-list{max-width:900px}.journal-list article{padding:32px 0;border-bottom:1px solid var(--secondary-gray)}.journal-list h2{font-size:26px;margin:16px 0;font-weight:400}.journal-list a{display:inline-block;margin-top:16px}.contact-block{padding-top:24px}.contact-block p{margin:20px 0;overflow-wrap:anywhere}.copy-control{border:1px solid var(--secondary-gray);background:white;padding:10px 16px;border-radius:8px;min-height:44px;margin-left:12px;cursor:pointer}.copy-result{display:block;min-height:24px}.directions{margin-top:32px}
@media(max-width:600px){.cards{grid-template-columns:1fr}.hub{padding-top:112px}.intro,.text-body{font-size:17px}}
</style>
