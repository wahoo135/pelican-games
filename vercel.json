{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/products/:slug",
      "destination": "/zh/games/:slug/",
      "permanent": true
    },
    {
      "source": "/articles",
      "destination": "/zh/journal/",
      "permanent": true
    },
    {
      "source": "/news/guangzhou-bgm-2026/",
      "destination": "/zh/journal/#guangzhou-bgm-2026",
      "permanent": true
    },
    {
      "source": "/news/emotion-theater-release/",
      "destination": "/zh/journal/#emotion-theater-release",
      "permanent": true
    }
  ]
}
